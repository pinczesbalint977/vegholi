# Rackhost / Apache: a www.vostone.hu domain dokumentumgyökerébe.
# A HTTPS-átirányításhoz előbb legyen érvényes SSL mindkét domainváltozaton.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A közvetlen index.html cím egyetlen lépésben a kanonikus főoldalra mutat.
  RewriteCond %{HTTP_HOST} ^(www\.)?vostone\.hu$ [NC]
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ https://www.vostone.hu/ [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^vostone\.hu$ [NC]
  RewriteRule ^ https://www.vostone.hu%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^www\.vostone\.hu$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://www.vostone.hu%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html?|xml|txt)$|^config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
